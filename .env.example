# ReRoute AI 2.0 - Environment Variables
# Configure these in your Vercel Project Settings (Settings > Environment Variables)
# or in a local .env file for development.

# Supabase Project URL (e.g., https://yourprojectid.supabase.co)
SUPABASE_URL=https://yourprojectid.supabase.co

# Supabase Anonymous Public Key (Safe for public clients, protected by Row Level Security)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
