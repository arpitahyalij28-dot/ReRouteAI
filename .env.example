# ==============================================================================
# ReRoute AI 2.0 - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SIDE ENVIRONMENT VARIABLES (Vite Frontend - Public)
# ------------------------------------------------------------------------------
# Supabase Project URL (e.g., https://yourprojectid.supabase.co)
VITE_SUPABASE_URL=https://yourprojectid.supabase.co

# Supabase Anonymous Public Key (Safe for public clients, protected by Row Level Security)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: Base URL for serverless backend API (leave blank for relative '/api')
# VITE_API_BASE=https://your-deployment.vercel.app

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE ONLY ENVIRONMENT VARIABLES (Vercel Serverless Functions - Secret)
# Never prefix with VITE_ to keep them out of client JS bundles.
# ------------------------------------------------------------------------------
# Supabase Service Role Key (Bypasses RLS - for admin seeding / serverless backend only)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Anthropic Claude API Key for /api/explain LLM summaries
ANTHROPIC_API_KEY=sk-ant-api03-...

# Anthropic Model ID (default: claude-3-5-haiku-20241022)
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# OpenRouteService API Key for real-world road geometries (/api/route)
OPENROUTESERVICE_API_KEY=5b3ce3597851110001cf6248...

# Allowed CORS Origin for serverless endpoints (e.g., https://reroute-ai.vercel.app)
# ALLOWED_ORIGIN=https://reroute-ai.vercel.app
